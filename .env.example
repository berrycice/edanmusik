# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MUSIK Server Configuration
PORT=3000

# Cloudflare R2 Credentials (Diperlukan agar musik tersimpan langsung ke bucket R2)
# Jika dikosongkan, server otomatis menggunakan Local Storage di folder data/media/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=edanmusik
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# Private App Authentication Token (Optional, for private library security)
PRIVATE_APP_TOKEN=

# Media Processing Constraints
MAX_FILE_SIZE_MB=100
TEMP_FILE_MAX_AGE_MINUTES=30
